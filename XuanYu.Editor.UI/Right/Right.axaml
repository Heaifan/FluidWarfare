<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI"
             x:Class="XuanYu.Editor.UI.Right"
             x:DataType="local:UiVm">
  <Grid>
    <local:EditorRightTabs IsVisible="{Binding !IsEditMode}"/>
    <Grid IsVisible="{Binding IsEditMode}" RowDefinitions="3*,Auto,*">
      <local:EditorRightTabs Grid.Row="0"/>
      <GridSplitter Grid.Row="1" Height="4" Background="{StaticResource Color.Border.Default}" HorizontalAlignment="Stretch" VerticalAlignment="Center" ResizeDirection="Rows"/>
      <Grid Grid.Row="2">
        <Grid RowDefinitions="2*,Auto,2*" IsVisible="{Binding !IsEntityInspector}">
          <Grid Grid.Row="0">
            <local:MapEditorPanel x:Name="MapWorkspace" IsVisible="{Binding IsMapEditMode}"/>
            <local:RegionalAuthoringPanel x:Name="RegionWorkspace" IsVisible="{Binding IsRegionEditMode}"/>
          </Grid>
          <GridSplitter Grid.Row="1" Height="4" Background="{StaticResource Color.Border.Default}" HorizontalAlignment="Stretch" VerticalAlignment="Center" ResizeDirection="Rows"/>
          <local:EditorLayerDock x:Name="LayerWorkspace" Grid.Row="2"/>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
