<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI"
             xmlns:xy="using:XYUI.Avalonia.Controls"
             x:Class="XuanYu.Editor.UI.EditorRightTabs"
             x:DataType="local:UiVm">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://XuanYu.Editor.UI/Icons/EditorIcons.axaml"/>
        <ResourceInclude Source="avares://XuanYu.Editor.UI/Right/TopTabStripTemplate.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="TabControl.sideTabs"><Setter Property="Template" Value="{StaticResource TopTabStripTemplate}"/></Style>
    <Style Selector="Grid.debugRow"><Setter Property="MinHeight" Value="26"/><Setter Property="Margin" Value="0,1"/></Style>
    <Style Selector="ItemsControl.debugList"><Setter Property="Margin" Value="0"/></Style>
  </UserControl.Styles>
  <TabControl x:Name="SideTabs" Classes="sideTabs" SelectedIndex="{Binding RightTabIndex, Mode=TwoWay}">
    <TabItem Classes="sideTab" Header="检查器"><local:InspectorPanel/></TabItem>
    <TabItem Classes="sideTab" Header="调试">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10" Margin="0,6,0,0">
          <StackPanel Spacing="4">
            <xy:XYSectionTitle Text="当前上下文"/>
            <ItemsControl Classes="debugList" ItemsSource="{Binding DebugContextItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:InspectorFieldRow">
                  <Grid Classes="debugRow" ColumnDefinitions="96,*" ColumnSpacing="8">
                    <xy:XYLabel Text="{Binding Label}"/>
                    <xy:XYText Grid.Column="1" Text="{Binding Value}" ToolTip.Tip="{Binding Value}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <StackPanel Spacing="4">
            <xy:XYSectionTitle Text="当前对象"/>
            <ItemsControl Classes="debugList" ItemsSource="{Binding DebugObjectItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:InspectorFieldRow">
                  <Grid Classes="debugRow" ColumnDefinitions="96,*" ColumnSpacing="8">
                    <xy:XYLabel Text="{Binding Label}"/>
                    <xy:XYText Grid.Column="1" Text="{Binding Value}" ToolTip.Tip="{Binding Value}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <StackPanel Spacing="6">
            <xy:XYSectionTitle Text="交互事务"/>
            <Grid ColumnDefinitions="96,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
              <xy:XYLabel Text="阶段"/>
              <xy:XYText Grid.Column="1" Text="{Binding InteractionPhase}" ToolTip.Tip="{Binding InteractionPhase}"/>
              <xy:XYLabel Grid.Row="1" Text="Owner"/>
              <xy:XYText Grid.Row="1" Grid.Column="1" Text="{Binding InteractionOwner}" ToolTip.Tip="{Binding InteractionOwner}"/>
              <xy:XYLabel Grid.Row="2" Text="Preview"/>
              <xy:XYText Grid.Row="2" Grid.Column="1" Text="{Binding InteractionPreview}" ToolTip.Tip="{Binding InteractionPreview}"/>
            </Grid>
            <UniformGrid Columns="4" ColumnSpacing="6" RowSpacing="6">
              <Button Classes="uiTextButton" Content="开始" Command="{Binding InteractionCommand}" CommandParameter="Begin"/>
              <Button Classes="uiTextButton" Content="预览" Command="{Binding InteractionCommand}" CommandParameter="Preview"/>
              <Button Classes="uiTextButton" Content="提交" Command="{Binding InteractionCommand}" CommandParameter="Commit"/>
              <Button Classes="uiTextButton" Content="取消" Command="{Binding InteractionCommand}" CommandParameter="Cancel"/>
            </UniformGrid>
          </StackPanel>
          <StackPanel Spacing="4">
            <xy:XYSectionTitle Text="输入状态"/>
            <ItemsControl Classes="debugList" ItemsSource="{Binding DebugInputItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:InspectorFieldRow">
                  <Grid Classes="debugRow" ColumnDefinitions="96,*" ColumnSpacing="8">
                    <xy:XYLabel Text="{Binding Label}"/>
                    <xy:XYText Grid.Column="1" Text="{Binding Value}" ToolTip.Tip="{Binding Value}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
  </TabControl>
</UserControl>
