<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI"
             xmlns:xy="using:XYUI.Avalonia.Controls"
             x:Class="XuanYu.Editor.UI.EditorLayerDock"
             x:DataType="local:UiVm">
  <UserControl.Styles>
    <Style Selector="Border.layerDockHeader"><Setter Property="BorderBrush" Value="{StaticResource Color.Border.Default}"/><Setter Property="BorderThickness" Value="0,1,0,0"/><Setter Property="Padding" Value="0,6"/></Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*">
    <Border Classes="layerDockHeader">
      <Grid ColumnDefinitions="*,Auto">
        <xy:XYSectionTitle Text="{Binding CurrentLayerEmptyTitle}" VerticalAlignment="Center"/>
        <Button x:Name="CollapseButton" Grid.Column="1" Content="收起" Click="CollapseButton_Click" Classes="uiTextButton" Padding="8,2" MinHeight="24"/>
      </Grid>
    </Border>
    <Grid x:Name="LayerContent" Grid.Row="1">
      <local:DatasetLayerPanel IsVisible="{Binding IsMapEditMode}"/>
      <Grid IsVisible="{Binding IsRegionEditMode}">
        <local:LayerPanel IsVisible="{Binding HasCurrentLayerItems}"/>
        <StackPanel IsVisible="{Binding !HasCurrentLayerItems}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="240" Spacing="6">
          <xy:XYEmptyText Text="{Binding CurrentLayerEmptyTitle}"/>
          <xy:XYCaption Text="{Binding CurrentLayerEmptyMessage}" TextWrapping="Wrap"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
