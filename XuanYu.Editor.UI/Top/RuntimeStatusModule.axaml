<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI"
             xmlns:xy="using:XYUI.Avalonia.Controls"
             x:Class="XuanYu.Editor.UI.RuntimeStatusModule"
             x:DataType="local:UiVm">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://XuanYu.Editor.UI/Icons/EditorIcons.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <StackPanel Orientation="Horizontal"
              Spacing="8"
              VerticalAlignment="Center">
    <Border BorderBrush="{StaticResource Color.Border.Default}"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius.Standard}"
            Padding="8,4"
            VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal"
                  Spacing="6"
                  VerticalAlignment="Center">
        <xy:XYCaption Text="运行"
                      VerticalAlignment="Center"/>
        <xy:XYButton Variant="Primary"
                     MinHeight="34"
                     Command="{Binding RunCommand}"
                     CommandParameter="运行"
                     ToolTip.Tip="启动场景模拟">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Path Classes="topIcon" Data="{StaticResource PlayIcon}" Stroke="White"/>
            <TextBlock Text="运行"/>
          </StackPanel>
        </xy:XYButton>
        <xy:XYButton Variant="Danger"
                     MinHeight="34"
                     Command="{Binding RunCommand}"
                     CommandParameter="停止"
                     ToolTip.Tip="停止场景模拟">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Path Classes="topIcon" Data="{StaticResource StopIcon}" Stroke="White"/>
            <TextBlock Text="停止"/>
          </StackPanel>
        </xy:XYButton>
      </StackPanel>
    </Border>
    <Border BorderBrush="{StaticResource Color.Border.Default}"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius.Standard}"
            Padding="8,4"
            VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal"
                  Spacing="6"
                  VerticalAlignment="Center">
        <xy:XYCaption Text="状态"
                      VerticalAlignment="Center"/>
        <xy:XYBadge Text="{Binding DocumentStatusText}"
                    Variant="Default"
                    ToolTip.Tip="文档状态"/>
        <xy:XYBadge Text="{Binding FooterMode}"
                    Variant="Default"
                    ToolTip.Tip="当前模式"/>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
