<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI"
             xmlns:xy="using:XYUI.Avalonia.Controls"
             x:Class="XuanYu.Editor.UI.Top"
             x:DataType="local:UiVm">
  <UserControl.Styles>
    <Style Selector="Path.topIcon">
      <Setter Property="Width" Value="14"/>
      <Setter Property="Height" Value="14"/>
      <Setter Property="Stretch" Value="Uniform"/>
      <Setter Property="Stroke" Value="{StaticResource Color.Text.Primary}"/>
      <Setter Property="StrokeThickness" Value="1.6"/>
    </Style>
    <Style Selector="Menu">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="MenuItem">
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource Color.Text.Primary}"/>
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,Auto"
        RowSpacing="8">
    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto"
          ColumnSpacing="8"
          VerticalAlignment="Center">
      <StackPanel Spacing="0"
                  VerticalAlignment="Center">
        <xy:XYHeading Text="玄域引擎"
                      Variant="PanelTitle"/>
        <xy:XYCaption Text="场景编辑器"/>
      </StackPanel>
      <xy:XYSeparator Grid.Column="1"
                      Variant="VerticalSplit"
                      Height="32"
                      Margin="4,0"/>
      <local:WorkspaceSelector Grid.Column="2"
                               VerticalAlignment="Center"/>
      <local:FileModule Grid.Column="3"
                        VerticalAlignment="Center"/>
      <local:RuntimeStatusModule Grid.Column="5"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Center"/>
    </Grid>
    <ScrollViewer Grid.Row="1"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Disabled">
      <StackPanel Orientation="Horizontal"
                  Spacing="8">
        <local:EditToolsModule/>
        <local:ViewModule/>
        <local:SnapModule/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
