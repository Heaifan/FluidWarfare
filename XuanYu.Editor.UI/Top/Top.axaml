<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI"
             xmlns:xy="using:XYUI.Avalonia.Controls"
             xmlns:xycore="using:XYUI.Avalonia"
             x:Class="XuanYu.Editor.UI.Top"
             x:DataType="local:UiVm">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://XuanYu.Editor.UI/Icons/EditorIcons.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <UserControl.Styles>
    <StyleInclude Source="avares://XuanYu.Editor.UI/Top/Top.States.axaml"/>
    <Style Selector="Border.commandRail"><Setter Property="Background" Value="#fbfdff"/><Setter Property="BorderBrush" Value="#d5dfec"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="9"/><Setter Property="Padding" Value="10,5"/></Style>
    <Style Selector="Border.topGroup"><Setter Property="Background" Value="Transparent"/><Setter Property="CornerRadius" Value="0"/><Setter Property="Padding" Value="0,0,10,0"/></Style>
    <Style Selector="Menu"><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="0"/></Style>
    <Style Selector="MenuItem"><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="11,5"/><Setter Property="Foreground" Value="#2f3d52"/></Style>
    <Style Selector="MenuItem:pointerover"><Setter Property="Background" Value="#edf3fb"/></Style>
    <Style Selector="Path.topIcon"><Setter Property="Width" Value="16"/><Setter Property="Height" Value="16"/><Setter Property="Stretch" Value="Uniform"/><Setter Property="Stroke" Value="#5d6d83"/><Setter Property="StrokeThickness" Value="1.6"/></Style>
    <Style Selector="Button.topCommand"><Setter Property="MinHeight" Value="32"/><Setter Property="MinWidth" Value="32"/><Setter Property="Padding" Value="7,4"/><Setter Property="Margin" Value="0"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="Button.topCommand:pointerover"><Setter Property="Background" Value="#edf3fb"/></Style>
    <Style Selector="Button.topCommand:pressed"><Setter Property="Background" Value="#dfeaf8"/></Style>
    <Style Selector="Button.topCommand:disabled"><Setter Property="Opacity" Value="0.48"/></Style>
    <Style Selector="ToggleButton.topTool"><Setter Property="MinHeight" Value="32"/><Setter Property="MinWidth" Value="32"/><Setter Property="Padding" Value="7,4"/><Setter Property="Margin" Value="0"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{StaticResource Color.Text.Primary}"/></Style>
    <Style Selector="ToggleButton.topTool:pointerover"><Setter Property="Background" Value="#edf3fb"/></Style>
    <Style Selector="ToggleButton.topTool:pressed"><Setter Property="Background" Value="#dfeaf8"/></Style>
    <Style Selector="ToggleButton.topTool:checked"><Setter Property="Background" Value="#eef5ff"/><Setter Property="BorderBrush" Value="#94b9e8"/><Setter Property="BorderThickness" Value="1,1,1,3"/><Setter Property="Foreground" Value="{StaticResource Color.Text.Primary}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="Button.topCommand:pointerover Path.topIcon"><Setter Property="Stroke" Value="#365d8d"/></Style>
    <Style Selector="ToggleButton.topTool:pointerover Path.topIcon"><Setter Property="Stroke" Value="#365d8d"/></Style>
    <Style Selector="ToggleButton.topTool:checked Path.topIcon"><Setter Property="Stroke" Value="#185aa6"/></Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto" RowSpacing="5" xycore:XY.Size="Compact" xycore:XY.Density="Compact">
    <Border Classes="commandRail">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Menu>
            <MenuItem>
              <MenuItem.Header><StackPanel Orientation="Horizontal" Spacing="4"><Path Classes="topIcon" Data="{StaticResource FolderIcon}"/><TextBlock Text="文件" VerticalAlignment="Center"/></StackPanel></MenuItem.Header>
              <MenuItem Header="新建" Command="{Binding RunCommand}" CommandParameter="新建"/>
              <MenuItem Header="打开" Command="{Binding RunCommand}" CommandParameter="打开"/>
              <MenuItem Header="保存" Command="{Binding RunCommand}" CommandParameter="保存"/>
              <MenuItem Header="另存为" Command="{Binding RunCommand}" CommandParameter="另存为"/>
              <MenuItem Header="导入 GLB" Command="{Binding RunCommand}" CommandParameter="导入 GLB"/>
            </MenuItem>
            <MenuItem>
              <MenuItem.Header><StackPanel Orientation="Horizontal" Spacing="4"><Path Classes="topIcon" Data="{StaticResource EntityIcon}"/><TextBlock Text="添加" VerticalAlignment="Center"/></StackPanel></MenuItem.Header>
              <MenuItem Header="立方体" Command="{Binding RunCommand}" CommandParameter="添加立方体"/>
            </MenuItem>
          </Menu>
          <xy:XYSeparator Variant="VerticalSplit" Height="24" Margin="4,0"/>
          <Border Classes="topGroup"><StackPanel Orientation="Horizontal" Spacing="4"><xy:XYButton Classes="topCommand" Variant="Secondary" Command="{Binding RunCommand}" CommandParameter="新建"><StackPanel Orientation="Horizontal" Spacing="5"><Path Classes="topIcon" Data="{StaticResource NewFileIcon}"/><TextBlock Text="新建"/></StackPanel></xy:XYButton><xy:XYButton Classes="topCommand" Variant="Secondary" Command="{Binding RunCommand}" CommandParameter="打开"><StackPanel Orientation="Horizontal" Spacing="5"><Path Classes="topIcon" Data="{StaticResource OpenIcon}"/><TextBlock Text="打开"/></StackPanel></xy:XYButton><xy:XYButton Classes="topCommand" Variant="Secondary" Command="{Binding RunCommand}" CommandParameter="保存" IsEnabled="{Binding CanRunSaveCommand}" Background="{Binding SaveButtonBackground}" BorderBrush="{Binding SaveButtonBorderBrush}"><StackPanel Orientation="Horizontal" Spacing="5"><Path Classes="topIcon" Data="{StaticResource SaveIcon}"/><TextBlock Text="保存"/></StackPanel></xy:XYButton><xy:XYButton Classes="topCommand" Variant="Secondary" Command="{Binding RunCommand}" CommandParameter="另存为"><StackPanel Orientation="Horizontal" Spacing="5"><Path Classes="topIcon" Data="{StaticResource SaveIcon}"/><TextBlock Text="另存为"/></StackPanel></xy:XYButton></StackPanel></Border>
          <xy:XYSeparator Variant="VerticalSplit" Height="24" Margin="4,0"/>
          <Border Classes="topGroup"><StackPanel Orientation="Horizontal" Spacing="4"><xy:XYButton Classes="topCommand" Variant="Secondary" Command="{Binding RunCommand}" CommandParameter="撤销"><StackPanel Orientation="Horizontal" Spacing="5"><Path Classes="topIcon" Data="{StaticResource UndoIcon}"/><TextBlock Text="撤销"/></StackPanel></xy:XYButton><xy:XYButton Classes="topCommand" Variant="Secondary" Command="{Binding RunCommand}" CommandParameter="重做"><StackPanel Orientation="Horizontal" Spacing="5"><Path Classes="topIcon" Data="{StaticResource RedoIcon}"/><TextBlock Text="重做"/></StackPanel></xy:XYButton></StackPanel></Border>
          <xy:XYSeparator Variant="VerticalSplit" Height="24" Margin="4,0"/>
          <Border Classes="topGroup"><StackPanel Orientation="Horizontal" Spacing="4"><xy:XYButton Classes="topCommand" Variant="Primary" Command="{Binding RunCommand}" CommandParameter="运行"><StackPanel Orientation="Horizontal" Spacing="5"><Path Classes="topIcon" Data="{StaticResource PlayIcon}"/><TextBlock Text="运行"/></StackPanel></xy:XYButton><xy:XYButton Classes="topCommand" Variant="Danger" Command="{Binding RunCommand}" CommandParameter="停止"><StackPanel Orientation="Horizontal" Spacing="5"><Path Classes="topIcon" Data="{StaticResource StopIcon}"/><TextBlock Text="停止"/></StackPanel></xy:XYButton></StackPanel></Border>
        </StackPanel>
        <xy:XYBadge Grid.Column="1" Text="{Binding DocumentStatusText}" Variant="Default" Background="{Binding DocumentStatusBackground}" BorderBrush="{Binding DocumentStatusBorderBrush}"/>
      </Grid>
    </Border>

    <Border Grid.Row="1" Classes="commandRail">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <local:WorkspaceSelector/>
          <xy:XYSeparator Variant="VerticalSplit" Height="24" Margin="4,0" IsVisible="{Binding IsEditMode}"/>
          <Border IsVisible="{Binding IsEditMode}" Classes="topGroup"><StackPanel Orientation="Horizontal" Spacing="4"><xy:XYToggleButton Classes="topTool" IsChecked="{Binding IsSelectTool, Mode=OneWay}" Command="{Binding SelectToolCommand}" CommandParameter="选择"><StackPanel Orientation="Horizontal" Spacing="5"><Path Classes="topIcon" Data="{StaticResource SelectIcon}"/><TextBlock Text="选择"/></StackPanel></xy:XYToggleButton><xy:XYToggleButton IsVisible="{Binding IsMapEditMode}" Classes="topTool" IsChecked="{Binding IsBoxSelectTool, Mode=OneWay}" Command="{Binding SelectToolCommand}" CommandParameter="框选"><StackPanel Orientation="Horizontal" Spacing="5"><Path Classes="topIcon" Data="{StaticResource BoxSelectIcon}"/><TextBlock Text="框选"/></StackPanel></xy:XYToggleButton></StackPanel></Border>
          <xy:XYSeparator Variant="VerticalSplit" Height="24" Margin="4,0" IsVisible="{Binding IsMapEditMode}"/>
          <Border IsVisible="{Binding IsMapEditMode}" Classes="topGroup"><StackPanel Orientation="Horizontal" Spacing="4"><xy:XYToggleButton Classes="topTool" IsChecked="{Binding IsMoveTool, Mode=OneWay}" Command="{Binding SelectToolCommand}" CommandParameter="移动"><StackPanel Orientation="Horizontal" Spacing="5"><Path Classes="topIcon" Data="{StaticResource MoveIcon}"/><TextBlock Text="移动"/></StackPanel></xy:XYToggleButton><xy:XYToggleButton Classes="topTool" IsChecked="{Binding IsRotateTool, Mode=OneWay}" Command="{Binding SelectToolCommand}" CommandParameter="旋转"><StackPanel Orientation="Horizontal" Spacing="5"><Path Classes="topIcon" Data="{StaticResource RotateIcon}"/><TextBlock Text="旋转"/></StackPanel></xy:XYToggleButton><xy:XYToggleButton Classes="topTool" IsChecked="{Binding IsScaleTool, Mode=OneWay}" Command="{Binding SelectToolCommand}" CommandParameter="缩放"><StackPanel Orientation="Horizontal" Spacing="5"><Path Classes="topIcon" Data="{StaticResource ScaleIcon}"/><TextBlock Text="缩放"/></StackPanel></xy:XYToggleButton></StackPanel></Border>
          <xy:XYSeparator Variant="VerticalSplit" Height="24" Margin="4,0"/>
          <Border Classes="topGroup"><StackPanel Orientation="Horizontal" Spacing="4"><xy:XYButton Classes="topCommand" Variant="Secondary" Command="{Binding RunCommand}" CommandParameter="聚焦"><StackPanel Orientation="Horizontal" Spacing="5"><Path Classes="topIcon" Data="{StaticResource FocusIcon}"/><TextBlock Text="聚焦"/></StackPanel></xy:XYButton><xy:XYButton Classes="topCommand" Variant="Secondary" Command="{Binding RunCommand}" CommandParameter="查看全部"><StackPanel Orientation="Horizontal" Spacing="5"><Path Classes="topIcon" Data="{StaticResource FocusIcon}"/><TextBlock Text="查看全部"/></StackPanel></xy:XYButton></StackPanel></Border>
          <xy:XYSeparator Variant="VerticalSplit" Height="24" Margin="4,0"/>
          <Border Classes="topGroup"><StackPanel Orientation="Horizontal" Spacing="4"><xy:XYButton Classes="topCommand" Variant="Secondary" Command="{Binding RunCommand}" CommandParameter="平移"><StackPanel Orientation="Horizontal" Spacing="5"><Path Classes="topIcon" Data="{StaticResource PanIcon}"/><TextBlock Text="平移"/></StackPanel></xy:XYButton><xy:XYButton Classes="topCommand" Variant="Secondary" Command="{Binding RunCommand}" CommandParameter="环绕"><StackPanel Orientation="Horizontal" Spacing="5"><Path Classes="topIcon" Data="{StaticResource OrbitIcon}"/><TextBlock Text="环绕"/></StackPanel></xy:XYButton></StackPanel></Border>
          <xy:XYSeparator Variant="VerticalSplit" Height="24" Margin="4,0"/>
          <Border Classes="topGroup"><StackPanel Orientation="Horizontal" Spacing="4"><xy:XYToggleButton IsVisible="{Binding IsMapEditMode}" Classes="topTool" IsChecked="{Binding IsSnapEnabled, Mode=OneWay}" Command="{Binding ToggleSnapCommand}"><StackPanel Orientation="Horizontal" Spacing="5"><Path Classes="topIcon" Data="{StaticResource SnapIcon}"/><TextBlock Text="吸附"/></StackPanel></xy:XYToggleButton><Menu><MenuItem Header="环境"><MenuItem Header="{Binding GridDisplayText}" Command="{Binding RunCommand}" CommandParameter="显示构造网格"/><MenuItem Header="{Binding OriginDisplayText}" Command="{Binding RunCommand}" CommandParameter="显示世界原点"/><MenuItem Header="{Binding WorldAxesDisplayText}" Command="{Binding RunCommand}" CommandParameter="显示世界坐标轴"/><MenuItem Header="{Binding EditorBackgroundDisplayText}" Command="{Binding RunCommand}" CommandParameter="显示编辑器背景"/></MenuItem></Menu></StackPanel></Border>
        </StackPanel>
        <xy:XYBadge Grid.Column="1" Text="{Binding FooterMode}" Variant="Default"/>
      </Grid>
    </Border>
  </Grid>
</UserControl>
