<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI"
             xmlns:xy="using:XYUI.Avalonia.Controls"
             x:Class="XuanYu.Editor.UI.FileModule"
             x:DataType="local:UiVm">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://XuanYu.Editor.UI/Icons/EditorIcons.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <Border BorderBrush="{StaticResource Color.Border.Default}"
          BorderThickness="1"
          CornerRadius="{StaticResource Radius.Standard}"
          Padding="8,4">
    <StackPanel Spacing="2">
      <xy:XYCaption Text="文件"/>
      <StackPanel Orientation="Horizontal"
                  Spacing="4">
        <Menu VerticalAlignment="Center">
          <MenuItem Header="文件">
            <MenuItem Header="新建" Command="{Binding RunCommand}" CommandParameter="新建"/>
            <MenuItem Header="打开" Command="{Binding RunCommand}" CommandParameter="打开"/>
            <MenuItem Header="保存" Command="{Binding RunCommand}" CommandParameter="保存"/>
            <MenuItem Header="另存为" Command="{Binding RunCommand}" CommandParameter="另存为"/>
            <MenuItem Header="导入 GLB" Command="{Binding RunCommand}" CommandParameter="导入 GLB"/>
          </MenuItem>
          <MenuItem Header="添加">
            <MenuItem Header="立方体" Command="{Binding RunCommand}" CommandParameter="添加立方体"/>
          </MenuItem>
        </Menu>
        <xy:XYButton Variant="Secondary"
                     MinHeight="32"
                     Command="{Binding RunCommand}"
                     CommandParameter="新建"
                     ToolTip.Tip="新建场景">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Path Classes="topIcon" Data="{StaticResource NewFileIcon}"/>
            <TextBlock Text="新建"/>
          </StackPanel>
        </xy:XYButton>
        <xy:XYButton Variant="Secondary"
                     MinHeight="32"
                     Command="{Binding RunCommand}"
                     CommandParameter="打开"
                     ToolTip.Tip="打开场景">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Path Classes="topIcon" Data="{StaticResource OpenIcon}"/>
            <TextBlock Text="打开"/>
          </StackPanel>
        </xy:XYButton>
        <xy:XYButton Variant="Secondary"
                     MinHeight="32"
                     IsEnabled="{Binding CanRunSaveCommand}"
                     Command="{Binding RunCommand}"
                     CommandParameter="保存"
                     ToolTip.Tip="保存场景">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Path Classes="topIcon" Data="{StaticResource SaveIcon}"/>
            <TextBlock Text="保存"/>
          </StackPanel>
        </xy:XYButton>
        <xy:XYSeparator Variant="VerticalSplit"
                        Height="20"
                        Margin="2,0"/>
        <xy:XYButton Variant="Secondary"
                     MinHeight="32"
                     Command="{Binding RunCommand}"
                     CommandParameter="撤销"
                     ToolTip.Tip="撤销">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Path Classes="topIcon" Data="{StaticResource UndoIcon}"/>
            <TextBlock Text="撤销"/>
          </StackPanel>
        </xy:XYButton>
        <xy:XYButton Variant="Secondary"
                     MinHeight="32"
                     Command="{Binding RunCommand}"
                     CommandParameter="重做"
                     ToolTip.Tip="重做">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Path Classes="topIcon" Data="{StaticResource RedoIcon}"/>
            <TextBlock Text="重做"/>
          </StackPanel>
        </xy:XYButton>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
