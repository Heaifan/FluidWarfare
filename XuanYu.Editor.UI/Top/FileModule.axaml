<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI"
             xmlns:xy="using:XYUI.Avalonia.Controls"
             x:Class="XuanYu.Editor.UI.FileModule"
             x:DataType="local:UiVm">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://XuanYu.Editor.UI/Icons/EditorIcons.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <Border BorderBrush="{StaticResource Color.Border.Default}"
          BorderThickness="1"
          CornerRadius="{StaticResource Radius.Standard}"
          Padding="8,4"
          VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
      <xy:XYCaption Text="文件"
                    VerticalAlignment="Center"/>
      <xy:XYMenuBar Classes="compact"
                    ShowDivider="False"
                    VerticalAlignment="Center">
        <xy:XYMenuBarItem Label="文件">
          <xy:XYMenu>
            <xy:XYMenuItem Label="新建" Command="{Binding RunCommand}" CommandParameter="新建"/>
            <xy:XYMenuItem Label="打开" Command="{Binding RunCommand}" CommandParameter="打开"/>
            <xy:XYMenuItem Label="保存" Command="{Binding RunCommand}" CommandParameter="保存"/>
            <xy:XYMenuItem Label="另存为" Command="{Binding RunCommand}" CommandParameter="另存为"/>
            <xy:XYMenuItem Label="导入 GLB" Command="{Binding RunCommand}" CommandParameter="导入 GLB"/>
          </xy:XYMenu>
        </xy:XYMenuBarItem>
        <xy:XYMenuBarItem Label="添加">
          <xy:XYMenu>
            <xy:XYMenuItem Label="立方体" Command="{Binding RunCommand}" CommandParameter="添加立方体"/>
          </xy:XYMenu>
        </xy:XYMenuBarItem>
      </xy:XYMenuBar>
      <xy:XYButton Variant="Secondary"
                   MinHeight="34"
                   Command="{Binding RunCommand}"
                   CommandParameter="新建"
                   ToolTip.Tip="新建场景">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Path Classes="topIcon" Data="{StaticResource NewFileIcon}"/>
          <TextBlock Text="新建"/>
        </StackPanel>
      </xy:XYButton>
      <xy:XYButton Variant="Secondary"
                   MinHeight="34"
                   Command="{Binding RunCommand}"
                   CommandParameter="打开"
                   ToolTip.Tip="打开场景">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Path Classes="topIcon" Data="{StaticResource OpenIcon}"/>
          <TextBlock Text="打开"/>
        </StackPanel>
      </xy:XYButton>
      <xy:XYButton Variant="Secondary"
                   MinHeight="34"
                   IsEnabled="{Binding CanRunSaveCommand}"
                   Command="{Binding RunCommand}"
                   CommandParameter="保存"
                   ToolTip.Tip="保存场景">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Path Classes="topIcon" Data="{StaticResource SaveIcon}"/>
          <TextBlock Text="保存"/>
        </StackPanel>
      </xy:XYButton>
      <xy:XYSeparator Variant="VerticalSplit"
                      Height="20"
                      Margin="2,0"/>
      <xy:XYButton Variant="Secondary"
                   MinHeight="34"
                   Command="{Binding RunCommand}"
                   CommandParameter="撤销"
                   ToolTip.Tip="撤销">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Path Classes="topIcon" Data="{StaticResource UndoIcon}"/>
          <TextBlock Text="撤销"/>
        </StackPanel>
      </xy:XYButton>
      <xy:XYButton Variant="Secondary"
                   MinHeight="34"
                   Command="{Binding RunCommand}"
                   CommandParameter="重做"
                   ToolTip.Tip="重做">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Path Classes="topIcon" Data="{StaticResource RedoIcon}"/>
          <TextBlock Text="重做"/>
        </StackPanel>
      </xy:XYButton>
    </StackPanel>
  </Border>
</UserControl>
