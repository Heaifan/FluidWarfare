<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI"
             xmlns:xy="using:XYUI.Avalonia.Controls"
             x:Class="XuanYu.Editor.UI.ViewModule"
             x:DataType="local:UiVm">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://XuanYu.Editor.UI/Icons/EditorIcons.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <Border BorderBrush="{StaticResource Color.Border.Default}"
          BorderThickness="1"
          CornerRadius="{StaticResource Radius.Standard}"
          Padding="8,4"
          VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal"
                Spacing="4"
                VerticalAlignment="Center">
      <xy:XYCaption Text="视图"
                    VerticalAlignment="Center"/>
      <xy:XYButton Variant="Secondary"
                   MinHeight="34"
                   Command="{Binding RunCommand}"
                   CommandParameter="聚焦"
                   ToolTip.Tip="聚焦选择对象">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Path Classes="topIcon" Data="{StaticResource FocusIcon}"/>
          <TextBlock Text="聚焦"/>
        </StackPanel>
      </xy:XYButton>
      <xy:XYButton Variant="Secondary"
                   MinHeight="34"
                   Command="{Binding RunCommand}"
                   CommandParameter="查看全部"
                   ToolTip.Tip="查看全部">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Path Classes="topIcon" Data="{StaticResource ViewAllIcon}"/>
          <TextBlock Text="全览"/>
        </StackPanel>
      </xy:XYButton>
      <xy:XYButton Variant="Secondary"
                   MinHeight="34"
                   Command="{Binding RunCommand}"
                   CommandParameter="平移"
                   ToolTip.Tip="平移视图">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Path Classes="topIcon" Data="{StaticResource PanIcon}"/>
          <TextBlock Text="平移"/>
        </StackPanel>
      </xy:XYButton>
      <xy:XYButton Variant="Secondary"
                   MinHeight="34"
                   Command="{Binding RunCommand}"
                   CommandParameter="环绕"
                   ToolTip.Tip="环绕视图">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Path Classes="topIcon" Data="{StaticResource OrbitIcon}"/>
          <TextBlock Text="环绕"/>
        </StackPanel>
      </xy:XYButton>
      <xy:XYMenuBar Classes="compact"
                    ShowDivider="False"
                    VerticalAlignment="Center">
        <xy:XYMenuBarItem Header="环境">
          <xy:XYMenu>
            <xy:XYMenuItem Label="构造网格"
                           CheckKind="Check"
                           IsChecked="{Binding ShowGrid}"
                           Command="{Binding RunCommand}"
                           CommandParameter="显示构造网格"/>
            <xy:XYMenuItem Label="世界原点"
                           CheckKind="Check"
                           IsChecked="{Binding ShowOrigin}"
                           Command="{Binding RunCommand}"
                           CommandParameter="显示世界原点"/>
            <xy:XYMenuItem Label="世界坐标轴"
                           CheckKind="Check"
                           IsChecked="{Binding ShowWorldAxes}"
                           Command="{Binding RunCommand}"
                           CommandParameter="显示世界坐标轴"/>
            <xy:XYMenuItem Label="编辑器背景"
                           CheckKind="Check"
                           IsChecked="{Binding ShowEditorBackground}"
                           Command="{Binding RunCommand}"
                           CommandParameter="显示编辑器背景"/>
          </xy:XYMenu>
        </xy:XYMenuBarItem>
      </xy:XYMenuBar>
    </StackPanel>
  </Border>
</UserControl>
