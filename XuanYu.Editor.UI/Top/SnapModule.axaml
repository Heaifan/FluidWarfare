<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI"
             xmlns:xy="using:XYUI.Avalonia.Controls"
             x:Class="XuanYu.Editor.UI.SnapModule"
             x:DataType="local:UiVm">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://XuanYu.Editor.UI/Icons/EditorIcons.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <Border BorderBrush="{StaticResource Color.Border.Default}"
          BorderThickness="1"
          CornerRadius="{StaticResource Radius.Standard}"
          Padding="8,4"
          VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal"
                Spacing="4"
                VerticalAlignment="Center">
      <xy:XYCaption Text="吸附"
                    VerticalAlignment="Center"/>
      <xy:XYToggleButton MinHeight="34"
                         IsEnabled="{Binding IsMapEditMode}"
                         IsChecked="{Binding IsSnapEnabled, Mode=OneWay}"
                         Command="{Binding ToggleSnapCommand}"
                         ToolTip.Tip="切换几何吸附">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Path Classes="topIcon" Data="{StaticResource SnapIcon}"/>
          <TextBlock Text="{Binding SnapMode}"/>
        </StackPanel>
      </xy:XYToggleButton>
    </StackPanel>
  </Border>
</UserControl>
