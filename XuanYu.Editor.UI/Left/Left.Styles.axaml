<Styles xmlns="https://github.com/avaloniaui"
        xmlns:xy="using:XYUI.Avalonia.Controls">
  <Style Selector="Border.projectTreeShell">
    <Setter Property="Background" Value="{DynamicResource XY.Brush.Surface.Panel}"/>
    <Setter Property="Padding" Value="8,8,6,6"/>
    <Setter Property="BorderBrush" Value="{DynamicResource XY.Brush.Border.Color.Default}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="xy|XYHeading">
    <Setter Property="Margin" Value="2,0,0,6"/>
  </Style>
  <Style Selector="xy|XYTabBar">
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Margin" Value="0,0,0,6"/>
  </Style>
  <Style Selector="xy|XYTabBar xy|XYTab">
    <Setter Property="MinWidth" Value="70"/>
  </Style>
  <Style Selector="xy|XYTab.xyui-tab-selected">
    <Setter Property="BorderBrush" Value="{DynamicResource XY.Brush.Border.Color.Strong}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="xy|XYText.treeContextLabel">
    <Setter Property="Margin" Value="2,0,0,4"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{DynamicResource XY.Brush.Text.Tertiary}"/>
  </Style>
  <Style Selector="ListBox.treeList">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
  </Style>
  <Style Selector="ListBox.treeList ListBoxItem">
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0"/>
  </Style>
  <Style Selector="Border.treeRow">
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="Padding" Value="0,0,6,0"/>
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ListBox.treeList ListBoxItem:pointerover Border.treeRow">
    <Setter Property="Background" Value="{DynamicResource XY.Brush.State.Color.Hover}"/>
  </Style>
  <Style Selector="ListBox.treeList ListBoxItem:selected Border.treeRow">
    <Setter Property="Background" Value="{DynamicResource XY.Brush.Surface.Selected}"/>
  </Style>
  <Style Selector="xy|XYIcon.treeIcon">
    <Setter Property="Width" Value="14"/>
    <Setter Property="Height" Value="14"/>
    <Setter Property="Stroke" Value="{DynamicResource XY.Brush.Text.Secondary}"/>
  </Style>
  <Style Selector="xy|XYTruncatedText.treeText">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{DynamicResource XY.Brush.Text.Primary}"/>
  </Style>
  <Style Selector="StackPanel.emptyWorkspace">
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Spacing" Value="4"/>
    <Setter Property="MaxWidth" Value="180"/>
  </Style>
  <Style Selector="xy|XYText.emptyWorkspaceText">
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{DynamicResource XY.Brush.Text.Secondary}"/>
  </Style>
  <Style Selector="xy|XYText.emptyWorkspaceHint">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="TextAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{DynamicResource XY.Brush.Text.Tertiary}"/>
  </Style>
</Styles>
