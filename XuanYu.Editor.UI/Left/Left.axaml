<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI"
             xmlns:xy="using:XYUI.Avalonia.Controls"
             x:Class="XuanYu.Editor.UI.Left"
             x:DataType="local:UiVm">
  <UserControl.Styles>
    <StyleInclude Source="avares://XuanYu.Editor.UI/Left/Left.Styles.axaml"/>
  </UserControl.Styles>
  <Grid ColumnDefinitions="52,8,*" Background="{DynamicResource XY.Brush.Surface.PanelAlt}">
    <Border Grid.Column="0" Classes="workspaceRailSurface">
      <xy:XYNavigationRail x:Name="WorkspaceRail"
                           LayoutVariant="Workspace"
                           Width="52"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"/>
    </Border>
    <Border Grid.Column="2" Classes="workspaceMainSurface">
      <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Classes="workspaceHeader">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="1">
              <xy:XYHeading x:Name="WorkspaceTitle" Variant="PanelTitle"/>
              <xy:XYCaption x:Name="WorkspaceSubtitle"/>
            </StackPanel>
            <xy:XYIcon x:Name="WorkspaceHeaderIcon"
                       Grid.Column="1"
                       Icon="Browse"
                       Size="Small"
                       Classes="workspaceHeaderIcon"/>
          </Grid>
        </Border>
        <Grid Grid.Row="1" x:Name="WorkspaceContent" Classes="workspaceContent">
          <local:ProjectWorkspace x:Name="ProjectWorkspace"/>
          <local:HierarchyWorkspace x:Name="HierarchyWorkspace"/>
          <local:MapEditorPanel x:Name="MapWorkspace"/>
          <local:RegionalAuthoringPanel x:Name="RegionWorkspace"/>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
