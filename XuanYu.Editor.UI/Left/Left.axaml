<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI"
             xmlns:xy="using:XYUI.Avalonia.Controls"
             x:Class="XuanYu.Editor.UI.Left"
             x:DataType="local:UiVm">
  <UserControl.Styles>
    <StyleInclude Source="avares://XuanYu.Editor.UI/Left/Left.Styles.axaml"/>
  </UserControl.Styles>
  <Border Classes="projectTreeShell">
    <Grid RowDefinitions="Auto,Auto,Auto,*">
      <xy:XYHeading x:Name="ProjectHeading" Text="项目树" Variant="PanelTitle"/>
      <xy:XYTabBar x:Name="ContentTabs" Grid.Row="1" SelectionChanged="ContentTabs_SelectionChanged">
        <xy:XYTab Id="project" Label="项目" IsSelected="True" ShowSelectedAccent="False"/>
        <xy:XYTab Id="file" Label="文件" ShowSelectedAccent="False"/>
      </xy:XYTabBar>
      <xy:XYText Grid.Row="2" Text="当前场景" Classes="treeContextLabel"/>
      <Grid Grid.Row="3" x:Name="ContentHost">
        <local:ProjectWorkspace x:Name="ProjectWorkspace"/>
        <StackPanel x:Name="FileWorkspace" IsVisible="False" Classes="emptyWorkspace">
          <xy:XYText Text="暂无文件" Classes="emptyWorkspaceText"/>
          <xy:XYText Text="当前没有独立文件列表数据。" Classes="emptyWorkspaceHint"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</UserControl>
