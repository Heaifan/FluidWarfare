<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI"
             xmlns:xy="using:XYUI.Avalonia.Controls"
             x:Class="XuanYu.Editor.UI.WorkspaceSelector"
             x:DataType="local:UiVm">
  <Border BorderBrush="{StaticResource Color.Border.Default}"
          BorderThickness="1"
          CornerRadius="{StaticResource Radius.Standard}"
          Padding="8,4">
    <Grid ColumnDefinitions="Auto,Auto"
          ColumnSpacing="12">
      <StackPanel Spacing="0"
                  VerticalAlignment="Center">
        <xy:XYHeading Text="工作区"
                      Variant="PanelTitle"/>
        <xy:XYCaption Text="当前工作区"/>
        <xy:XYCaption Text="{Binding CurrentWorkspaceDisplayName}"/>
      </StackPanel>
      <StackPanel Grid.Column="1"
                  Spacing="2"
                  VerticalAlignment="Center">
        <xy:XYCaption Text="编辑模式"/>
        <xy:XYButton Variant="Secondary"
                     MinHeight="32"
                     MinWidth="112"
                     Padding="{StaticResource Padding.Compact}"
                     Content="{Binding CurrentEditorModeText}"
                     Command="{Binding ToggleEditorModeCommand}"
                     ToolTip.Tip="点击切换管理模式与编辑模式"/>
        <Menu IsVisible="{Binding IsEditMode}"
              HorizontalAlignment="Right">
          <MenuItem Header="切换工作区">
            <MenuItem Header="地图编辑"
                      ToggleType="Radio"
                      IsChecked="{Binding IsMapWorkspace, Mode=OneWay}"
                      Command="{Binding SwitchWorkspaceCommand}"
                      CommandParameter="MapEditor"/>
            <MenuItem Header="区域编辑"
                      ToggleType="Radio"
                      IsChecked="{Binding IsRegionWorkspace, Mode=OneWay}"
                      Command="{Binding SwitchWorkspaceCommand}"
                      CommandParameter="RegionEditor"/>
          </MenuItem>
        </Menu>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
