<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI"
             xmlns:xy="using:XYUI.Avalonia.Controls"
             x:Class="XuanYu.Editor.UI.WorkspaceSelector"
             x:DataType="local:UiVm">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://XuanYu.Editor.UI/Icons/EditorIcons.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <Border BorderBrush="{StaticResource Color.Border.Default}"
          BorderThickness="1"
          CornerRadius="{StaticResource Radius.Standard}"
          Padding="8,4"
          VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
      <xy:XYCaption Text="工作区"
                    VerticalAlignment="Center"/>
      <xy:XYButton Variant="Secondary"
                   MinHeight="34"
                   Padding="{StaticResource Padding.Compact}"
                   Content="{Binding CurrentEditorModeText}"
                   Command="{Binding ToggleEditorModeCommand}"
                   ToolTip.Tip="点击切换管理模式与编辑模式"/>
      <Menu VerticalAlignment="Center">
        <MenuItem ToolTip.Tip="切换工作区">
          <MenuItem.Header>
            <StackPanel Orientation="Horizontal"
                        Spacing="4"
                        VerticalAlignment="Center">
              <TextBlock Text="{Binding CurrentWorkspaceDisplayName}"/>
              <Path Classes="topIcon"
                    Data="{StaticResource ChevronDownIcon}"
                    Width="10"
                    Height="10"/>
            </StackPanel>
          </MenuItem.Header>
          <MenuItem Header="地图编辑"
                    ToggleType="Radio"
                    IsChecked="{Binding IsMapWorkspace, Mode=OneWay}"
                    Command="{Binding SwitchWorkspaceCommand}"
                    CommandParameter="MapEditor"/>
          <MenuItem Header="区域编辑"
                    ToggleType="Radio"
                    IsChecked="{Binding IsRegionWorkspace, Mode=OneWay}"
                    Command="{Binding SwitchWorkspaceCommand}"
                    CommandParameter="RegionEditor"/>
        </MenuItem>
      </Menu>
    </StackPanel>
  </Border>
</UserControl>
