<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:XuanYu.Editor.UI"
             xmlns:xy="using:XYUI.Avalonia.Controls"
             xmlns:xycore="using:XYUI.Avalonia"
             x:Class="XuanYu.Editor.UI.WorkspaceSelector"
             x:DataType="local:UiVm">
  <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceInclude Source="avares://XuanYu.Editor.UI/Icons/EditorIcons.axaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Button.workspaceMode"><Setter Property="Height" Value="28"/><Setter Property="Padding" Value="10,3"/><Setter Property="Background" Value="{StaticResource Color.Selection.Bg}"/><Setter Property="BorderBrush" Value="{StaticResource Color.Border.Default}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource Color.Text.Primary}"/></Style>
    <Style Selector="Button.workspaceMode:pointerover"><Setter Property="Background" Value="{StaticResource Color.Hover.Bg}"/></Style>
    <Style Selector="Border.workspaceModeSplit"><Setter Property="Height" Value="28"/><Setter Property="Background" Value="{StaticResource Color.Selection.Bg}"/><Setter Property="BorderBrush" Value="{StaticResource Color.Border.Default}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/></Style>
    <Style Selector="Button.workspaceModeMain"><Setter Property="Padding" Value="10,3"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource Color.Text.Primary}"/></Style>
    <Style Selector="MenuItem.workspaceChevron"><Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="Padding" Value="6"/><Setter Property="Background" Value="Transparent"/></Style>
  </UserControl.Styles>
  <StackPanel Orientation="Horizontal" Spacing="4" xycore:XY.Size="Compact" xycore:XY.Density="Compact">
    <xy:XYButton Classes="workspaceMode" Variant="Secondary" Content="管理模式" Command="{Binding ToggleEditorModeCommand}" DoubleTapped="ModeSurface_DoubleTapped" ToolTip.Tip="点击或按 Tab 进入编辑模式"/>
    <Border Classes="workspaceModeSplit">
      <Grid ColumnDefinitions="*,28">
        <xy:XYButton Classes="workspaceModeMain" Variant="Secondary" Content="{Binding CurrentEditorModeText}" Command="{Binding ToggleEditorModeCommand}" DoubleTapped="ModeSurface_DoubleTapped" ToolTip.Tip="点击或按 Tab 返回管理模式"/>
        <Menu Grid.Column="1">
          <MenuItem Classes="workspaceChevron" ToolTip.Tip="切换编辑器">
            <MenuItem.Header><Path Data="{StaticResource ChevronDownIcon}" Width="16" Height="16" Stroke="{StaticResource Color.Text.Primary}" StrokeThickness="1.5"/></MenuItem.Header>
            <MenuItem Header="地图编辑" ToggleType="Radio" IsChecked="{Binding IsMapWorkspace, Mode=OneWay}" Command="{Binding SwitchWorkspaceCommand}" CommandParameter="MapEditor"/>
            <MenuItem Header="区域编辑" ToggleType="Radio" IsChecked="{Binding IsRegionWorkspace, Mode=OneWay}" Command="{Binding SwitchWorkspaceCommand}" CommandParameter="RegionEditor"/>
          </MenuItem>
        </Menu>
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
